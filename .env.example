# Copie este arquivo para .env ao rodar a API diretamente com uvicorn (fora do Docker).
# Ao rodar via `docker compose up`, essas variaveis ja vem definidas no docker-compose.yml
# (com DYNAMODB_ENDPOINT_URL=http://dynamodb-local:8000, o hostname interno do container).

# Porta 8001 = porta do dynamodb-local mapeada no host pelo docker-compose.yml
DYNAMODB_ENDPOINT_URL=http://localhost:8001
AWS_REGION=us-east-1
POLLS_TABLE_NAME=Polls
